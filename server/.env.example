NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fastlance?replicaSet=rs0
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
COOKIE_NAME=fastlance_refresh
COOKIE_SAME_SITE=lax
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STORAGE_PROVIDER=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional development seed password; never use a real account password.
SEED_PASSWORD=
